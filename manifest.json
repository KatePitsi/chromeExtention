{
  "manifest_version": 3,
  "name": "FE Inspector",
  "version": "1.37.0",
  "minimum_chrome_version": "130",
  "author": "Catherine Pitsigavdaki",
  "description": "Hover any element to inspect size, spacing, grid, flex, colour contrast and accessibility. Freeze elements to compare them.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FE Inspector — toggle",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Toggle FE Inspector"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "panel/render.js",
        "content/inspector.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel/panel.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
